NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Kajabi Public API (Settings -> Public API in the Kajabi dashboard)
KAJABI_CLIENT_ID=your-kajabi-client-id
KAJABI_CLIENT_SECRET=your-kajabi-client-secret
KAJABI_SITE_ID=2147637375

# Any random string - protects the cron endpoint from being called by
# anyone else who finds the URL. Vercel auto-sends this as a Bearer
# header when it triggers the cron job, if this env var is set.
CRON_SECRET=generate-a-random-string-here
